<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinHardwareMultitool</AssemblyName>
    <RootNamespace>WinHardwareMultitool</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds a global "using System.Drawing;" which collides with the WPF
         Color/Point/Brushes types used throughout the rest of the app. TrayIconService.cs
         already has its own explicit "using System.Drawing;" where it's actually needed. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
